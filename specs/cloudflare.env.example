# Non-secret variables belong in wrangler.jsonc or environment-specific config.
PUBLIC_BASE_URL=https://webrtc-bridge-signaling.example.workers.dev
SESSION_TTL_SECONDS=300
SIGNALING_TIMEOUT_SECONDS=60
ENABLE_TURN=false

# Set these with `wrangler secret put ...`; never commit actual values.
TOKEN_HMAC_SECRET=<32-bytes-or-more-random-secret>
TURN_KEY_ID=<optional-cloudflare-turn-key-id>
TURN_KEY_API_TOKEN=<optional-cloudflare-turn-api-token>
