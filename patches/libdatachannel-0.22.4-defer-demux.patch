+bool DtlsSrtpTransport::deferMessage(message_ptr message) {
+	// Same classification as demuxMessage(), except that a non-DTLS message is
+	// queued instead of dispatched. ReadCallback runs inside mbedtls_ssl_read,
+	// which DtlsTransport::doRecv() calls while holding mSslMutex; dispatching
+	// from there inverts the lock order against a callback that calls send()
+	// (mSslMutex again), so the dispatch happens in flushDemuxed() instead.
+	if (!mInitDone)
+		return false;
+
+	if (message->size() == 0)
+		return false;
+
+	uint8_t value1 = to_integer<uint8_t>(*message->begin());
+	if (value1 >= 20 && value1 <= 63)
+		return false; // DTLS, feed it to the TLS stack
+
+	{
+		std::lock_guard lock(mDemuxMutex);
+		mDemuxedMessages.push_back(std::move(message));
 	}
+	return true;
 }
 
+void DtlsSrtpTransport::flushDemuxed() {
+	std::vector<message_ptr> messages;
+	{
+		std::lock_guard lock(mDemuxMutex);
+		if (mDemuxedMessages.empty())
+			return;
+		messages = std::move(mDemuxedMessages);
+		mDemuxedMessages.clear();
+	}
+
+	// Outside mDemuxMutex: demuxMessage() dispatches up to the application.
+	for (auto &message : messages)
+		demuxMessage(std::move(message));
+}
